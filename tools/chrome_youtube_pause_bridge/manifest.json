{
  "manifest_version": 3,
  "name": "TravelMate YouTube Pause Bridge",
  "version": "1.1.0",
  "description": "Sends paused YouTube playback to the TravelMate backend on the private network.",
  "permissions": [],
  "host_permissions": [
    "https://bogogago.kro.kr/*",
    "http://192.168.219.122:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
